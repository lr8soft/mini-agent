{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@renderer/*": ["src/renderer/src/*"], "@shared/*": ["src/shared/*"] },
    "types": []
  },
  "include": ["src/renderer/src", "src/shared", "src/preload"]
}
