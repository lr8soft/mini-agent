{
  "extends": "./tsconfig.json",

  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],

    "jsx": "react-jsx",

    "types": [
      "vite/client"
    ],

    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ]
    }
  },

  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/renderer/src/**/*.d.ts",

    "src/shared/**/*.ts",
    "src/shared/**/*.tsx",
    "src/shared/**/*.d.ts"
  ]
}